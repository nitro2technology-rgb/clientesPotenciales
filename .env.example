# ============================================================
#  PLANTILLA. Copia este archivo como .env y rellena los valores.
#
#  El .env SI esta en .gitignore; este .example no lleva secretos.
#  NO lo compartas, no lo pegues en un chat, no lo subas a Drive.
#
#  Reglas al pegar valores:
#   - Sin comillas y sin espacios alrededor del "="
#   - En rutas de Windows usa barras normales:  C:/Users/nitro/...
#     (o barras dobles:  C:\\Users\\nitro\\...)
# ============================================================


# ------------------------------------------------------------
#  1 de 3 - API KEY  (Places API New + Geocoding API)
# ------------------------------------------------------------
#  Donde sacarla: Google Cloud Console -> APIs y servicios -> Credenciales
#  Empieza por "AIza..."
#  Pegala justo despues del "=" en la linea de abajo.
#
GOOGLE_MAPS_API_KEY=


# ------------------------------------------------------------
#  2 de 3 - RUTA AL JSON DE LA SERVICE ACCOUNT
# ------------------------------------------------------------
#  NO pegues el contenido del JSON aqui: pega la RUTA al archivo.
#  Recomendado: mueve el archivo a la carpeta credentials/ de este
#  proyecto (ya esta ignorada por git) y deja la ruta asi:
#
#      GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service_account.json
#
#  Tambien sirve una ruta absoluta:
#      GOOGLE_SERVICE_ACCOUNT_FILE=C:/Users/nitro/Descargas/mi-cred.json
#
GOOGLE_SERVICE_ACCOUNT_FILE=


# ------------------------------------------------------------
#  3 de 3 - ID DEL GOOGLE SHEET
# ------------------------------------------------------------
#  Es el codigo largo que sale en la URL del Sheet, entre /d/ y /edit:
#  https://docs.google.com/spreadsheets/d/ESTA_PARTE_DE_AQUI/edit
#
GOOGLE_SHEET_ID=

#  Nombre de la pestana dentro del Sheet. Si no existe, la app la crea.
GOOGLE_SHEET_TAB=Leads


# ============================================================
#  CONTROL DE COSTOS
# ============================================================
#  Tope duro de requests por dia. Al llegar, la app se bloquea sola.
#  Arranca bajo mientras validas que todo funciona; subelo despues.
MAX_REQUESTS_PER_DAY=50

#  Maximo de paginas por busqueda (1 pagina = ~20 negocios = 1 request)
MAX_PAGES_PER_SEARCH=3

#  MODO CAMPANA: cuantos sectores del mapa se exploran cada vez que
#  pulsas Buscar. Cada sector cuesta hasta MAX_PAGES_PER_SEARCH requests.
CELDAS_POR_SESION=5

#  Si es true, la app pide confirmacion en pantalla antes de cada
#  busqueda que gaste dinero. Dejalo en true.
CONFIRMAR_ANTES_DE_GASTAR=true


# ============================================================
#  MODO DEMO
# ============================================================
#  true  = datos falsos, NO llama a Google, NO gasta dinero
#  false = busquedas reales contra Google (SI gasta)
DEMO_MODE=false


# ============================================================
#  SERVIDOR
# ============================================================
HOST=127.0.0.1
PORT=8000


# ============================================================
#  BASE DE DATOS EN LA NUBE (Turso) - solo para el despliegue
# ============================================================
#  En tu PC no hace falta tocar nada: si estas dos lineas estan
#  vacias, la app usa el fichero de siempre, data/leads.db.
#
#  Desplegada en Vercel el disco es de solo lectura y se borra
#  entre peticiones, asi que el historico, las campanas a medias
#  y el CONTADOR DE CUOTA DIARIA tienen que vivir fuera. Turso es
#  SQLite alojado, con plan gratuito de sobra para esto.
#
#  Como sacar los dos valores (una vez creada la base):
#      turso db show --url <nombre-de-tu-base>
#      turso db tokens create <nombre-de-tu-base>
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=


# ============================================================
#  CREDENCIALES DE SHEETS SIN FICHERO (para el despliegue)
# ============================================================
#  Alternativa a GOOGLE_SERVICE_ACCOUNT_FILE cuando no hay disco
#  donde dejar el .json: se pega el JSON entero, en una sola linea.
#  En local es mas comodo seguir usando el fichero.
GOOGLE_SERVICE_ACCOUNT_JSON=
